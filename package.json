{
  "name": "carsai-host",
  "version": "1.0.0",
  "private": true,
  "description": "CARSAI HOST — Free web hosting platform with iFastNet/Byet + MOFH integration. Inspired by Xera. Multi-language (PT/EN/FR/ES).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@carsai/web",
    "dev:api": "turbo run dev --filter=@carsai/api",
    "dev:installer": "turbo run dev --filter=@carsai/installer",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@carsai/web",
    "build:api": "turbo run build --filter=@carsai/api",
    "build:shared": "turbo run build --filter=@carsai/shared",
    "build:installer": "turbo run build --filter=@carsai/installer",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @carsai/api drizzle-kit generate",
    "db:migrate": "pnpm --filter @carsai/api node scripts/migrate.js",
    "db:studio": "pnpm --filter @carsai/api drizzle-kit studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.3",
    "turbo": "^2.0.14",
    "typescript": "^5.5.4"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "always"
  }
}
