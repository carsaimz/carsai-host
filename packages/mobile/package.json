{
  "name": "@carsai/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "CARSAI HOST -- Capacitor 6 mobile shell that wraps the React web app and exposes native helpers (biometric, push, share, encrypted storage).",
  "scripts": {
    "dev": "echo 'Run pnpm dev:web then pnpm cap:sync && pnpm cap:open:ios|android'",
    "build": "pnpm cap:sync",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "cap:sync": "cap sync",
    "cap:copy": "cap copy",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:run:ios": "cap run ios",
    "cap:run:android": "cap run android",
    "clean": "rm -rf ios android .gradle node_modules"
  },
  "dependencies": {
    "@capacitor-community/biometric-auth": "^7.0.0",
    "@capacitor-community/sqlite": "^6.0.0",
    "@capacitor/camera": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
