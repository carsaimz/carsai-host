{
  "name": "@carsai/installer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CARSAI HOST -- Web installer wizard (Vite + React + TS + Tailwind)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5174",
