# ─── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
APP_NAME=CARSAI HOST

# ─── Database (SQLite) ─────────────────────────────────────────
DATABASE_URL=./data/carsai.db

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=replace-with-random-64-char-string
JWT_REFRESH_SECRET=replace-with-another-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=carsai-host
JWT_AUDIENCE=carsai-host-users

# ─── MOFH (iFastNet / Byet) ────────────────────────────────────
MOFH_API_URL=https://panel.myownfreehost.com/xml-api
MOFH_RESELLER_USERNAME=your-ifastnet-reseller-username
MOFH_RESELLER_PASSWORD=your-ifastnet-reseller-password
MOFH_DEFAULT_PACKAGE=freehosting
MOFH_DEFAULT_DOMAIN=yoursite.com
MOFH_DEFAULT_LANGUAGE=en

# ─── SMTP ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@carsai.host
SMTP_PASS=your-smtp-password
SMTP_FROM=CARSAI HOST <noreply@carsai.host>

# ─── OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── Rate limits ───────────────────────────────────────────────
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ─── Redis (optional — for Bull queues) ────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Installer lockfile ────────────────────────────────────────
INSTALLED_LOCKFILE=./data/.installed
