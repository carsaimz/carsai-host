# ─── CARSAI HOST — Frontend env vars ────────────────────────────
# Copie para .env.local e ajuste conforme necessario.

# URL base da API (backend Express em :3000).
# Em desenvolvimento, o Vite faz proxy de /api -> http://localhost:3000,
# por isso basta deixar "/api/v1".
VITE_API_URL=/api/v1

# Nome publico da aplicacao
VITE_APP_NAME=CARSAI HOST

# Locale por defeito (pt | en | fr | es)
VITE_DEFAULT_LOCALE=pt
